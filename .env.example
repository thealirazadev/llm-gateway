# Copy to .env and fill in. Never commit .env.

# SQLite database file used by both the server and the lgw CLI.
DATABASE_URL=sqlite:///data/gateway.db

# Upstream credentials. Required only for providers that appear in model routes.
OPENAI_API_KEY=sk-dummy-openai-key
ANTHROPIC_API_KEY=sk-ant-dummy-key
GEMINI_API_KEY=dummy-gemini-key

# Optional: enables the exact-cache accelerator. Unset means SQLite only.
REDIS_URL=

# Optional: enables the semantic cache layer. Unset means exact matching only.
LGW_EMBEDDING_PROVIDER=
LGW_EMBEDDING_MODEL=

# Upstream connect timeout, and read timeout for non-streaming calls
# (per-chunk gap for streams).
LGW_CONNECT_TIMEOUT_SECONDS=5
LGW_UPSTREAM_TIMEOUT_SECONDS=120

# Output cap used for budget estimates and for Anthropic's required max_tokens.
LGW_DEFAULT_MAX_OUTPUT_TOKENS=1024

# Stale reservations older than this are released by the sweeper.
LGW_RESERVATION_TTL_SECONDS=900

# Cache tuning.
LGW_CACHE_SIMILARITY_THRESHOLD=0.93
LGW_CACHE_TTL_HOURS=24
LGW_CACHE_SCAN_LIMIT=512
LGW_CACHE_MAX_ENTRIES_PER_KEY=2000

# Request body limit in kilobytes; larger bodies are rejected with 413.
LGW_MAX_BODY_KB=256

# Debug aid: logs redacted request bodies to the structured log, never to the database.
LGW_LOG_BODIES=false
